<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.mp3retrowidget"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="21"
        android:targetSdkVersion="34" />

    <!--
         These are declared so the app can be granted media control on ROMs that
         expose them; on stock Android they are simply ignored.
    -->
    <uses-permission android:name="android.permission.BIND_APPWIDGET" />
    <uses-permission android:name="android.permission.MEDIA_CONTENT_CONTROL" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:allowBackup="true"
        android:debuggable="true"
        android:extractNativeLibs="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MP3Retro" >

        <!-- Widget provider -->
        <receiver
            android:name="com.example.mp3retrowidget.MP3WidgetProvider"
            android:exported="true"
            android:label="@string/app_name" >
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_provider_info" />
        </receiver>

        <!--
             Skin selector + photo, shown when the widget is placed and when the
             user long-presses the widget and taps "Ajustes".
        -->
        <activity
            android:name="com.example.mp3retrowidget.WidgetConfigureActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/Theme.MP3Retro.NoTitleBar" >
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!--
             Settings. Not a launcher entry itself: the alias below is, so it can
             be disabled to hide the app from the drawer.
        -->
        <activity
            android:name="com.example.mp3retrowidget.MainActivity"
            android:exported="true"
            android:label="@string/app_name" /> <!-- Launcher entry (enabled/disabled by the "Ocultar app del cajón" switch) -->
        <activity-alias
            android:name="com.example.mp3retrowidget.LauncherAlias"
            android:enabled="true"
            android:exported="true"
            android:icon="@drawable/ic_launcher"
            android:label="@string/app_name"
            android:targetActivity="com.example.mp3retrowidget.MainActivity" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Photo cropper -->
        <activity
            android:name="com.example.mp3retrowidget.CropActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MP3Retro.NoTitleBar" />

        <!-- Invisible trampoline used to open Spotify / YouTube Music from the widget -->
        <activity
            android:name="com.example.mp3retrowidget.OpenMusicActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:theme="@style/Theme.MP3Retro.Translucent" />

        <!--
             Callback bridge for the active media session (needed to read the
             current song and to send exact transport commands). It is a bound
             system service, NOT a foreground playback service.
        -->
        <service
            android:name="com.example.mp3retrowidget.MediaNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE" >
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>