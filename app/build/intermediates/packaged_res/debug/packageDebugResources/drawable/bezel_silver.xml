<?xml version="1.0" encoding="utf-8"?>
<!-- Screen bezel: polished metal frame. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="9dp" />
            <gradient
                android:angle="270"
                android:startColor="#FAFBFD"
                android:centerColor="#B3BAC3"
                android:endColor="#7C838C" />
            <stroke
                android:width="1dp"
                android:color="#5B626A" />
        </shape>
    </item>
</layer-list>
