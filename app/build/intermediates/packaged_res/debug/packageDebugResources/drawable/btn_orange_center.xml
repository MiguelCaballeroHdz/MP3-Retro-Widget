<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:centerX="0.4"
                android:centerY="0.3"
                android:gradientRadius="32dp"
                android:startColor="#FF9C74"
                android:centerColor="#EE4E22"
                android:endColor="#9C2B0C" />
            <stroke
                android:width="1dp"
                android:color="#6E1B08" />
        </shape>
    </item>
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:centerX="0.36"
                android:centerY="0.28"
                android:gradientRadius="26dp"
                android:startColor="#FFB796"
                android:centerColor="#F45C30"
                android:endColor="#B83211" />
        </shape>
    </item>
</layer-list>
