<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:centerX="0.4"
                android:centerY="0.32"
                android:gradientRadius="32dp"
                android:startColor="#FFFFFF"
                android:centerColor="#D6DBE1"
                android:endColor="#7C838B" />
            <stroke
                android:width="1dp"
                android:color="#4C535B" />
        </shape>
    </item>
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:centerX="0.36"
                android:centerY="0.3"
                android:gradientRadius="26dp"
                android:startColor="#FFFFFF"
                android:centerColor="#EEF1F4"
                android:endColor="#A6ADB5" />
        </shape>
    </item>
</layer-list>
