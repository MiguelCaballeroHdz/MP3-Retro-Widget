<?xml version="1.0" encoding="utf-8"?>
<!-- FLIP: dark green-tinted inner display. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <gradient
                android:angle="270"
                android:startColor="#0A2115"
                android:centerColor="#06170F"
                android:endColor="#030C08" />
            <stroke
                android:width="1dp"
                android:color="#0C2A1A" />
        </shape>
    </item>
</layer-list>
