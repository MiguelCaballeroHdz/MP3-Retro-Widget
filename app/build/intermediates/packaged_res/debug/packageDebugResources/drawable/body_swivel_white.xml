<?xml version="1.0" encoding="utf-8"?>
<!-- SWIVEL WHITE: glossy white body with orange side accents (the accents are
     separate views so the photo layer can sit under them). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="270"
                android:startColor="#FFFFFF"
                android:centerColor="#F2F3F5"
                android:endColor="#D8DBE0" />
            <stroke
                android:width="1dp"
                android:color="#B9BDC4" />
        </shape>
    </item>
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="15dp" />
            <gradient
                android:angle="270"
                android:startColor="#99FFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#22000000" />
        </shape>
    </item>
</layer-list>
