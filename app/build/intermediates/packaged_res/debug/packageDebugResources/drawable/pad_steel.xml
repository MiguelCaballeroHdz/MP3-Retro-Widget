<?xml version="1.0" encoding="utf-8"?>
<!-- Keypad plate: blue-grey steel. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient
                android:angle="270"
                android:startColor="#5E6D7A"
                android:centerColor="#3A4753"
                android:endColor="#222C35" />
            <stroke
                android:width="1dp"
                android:color="#141A20" />
        </shape>
    </item>
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <gradient
                android:angle="270"
                android:startColor="#33FFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#33000000" />
        </shape>
    </item>
</layer-list>
