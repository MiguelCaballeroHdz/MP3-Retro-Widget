<?xml version="1.0" encoding="utf-8"?>
<!-- SLIDER: grey monochrome LCD. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="3dp" />
            <gradient
                android:angle="270"
                android:startColor="#16161A"
                android:centerColor="#0C0C0E"
                android:endColor="#050506" />
            <stroke
                android:width="1dp"
                android:color="#2A2A2F" />
        </shape>
    </item>
</layer-list>
