<?xml version="1.0" encoding="utf-8"?>
<!-- SLIDER: fixed sliding groove on the right edge (decorative only). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="5dp" />
            <gradient
                android:angle="270"
                android:startColor="#0A0A0C"
                android:centerColor="#232327"
                android:endColor="#0A0A0C" />
            <stroke
                android:width="1dp"
                android:color="#414147" />
        </shape>
    </item>
</layer-list>
