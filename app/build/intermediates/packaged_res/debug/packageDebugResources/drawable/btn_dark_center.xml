<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:centerX="0.4"
                android:centerY="0.3"
                android:gradientRadius="32dp"
                android:startColor="#4A4A52"
                android:centerColor="#222226"
                android:endColor="#080809" />
            <stroke
                android:width="1dp"
                android:color="#5A5A63" />
        </shape>
    </item>
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:centerX="0.36"
                android:centerY="0.28"
                android:gradientRadius="26dp"
                android:startColor="#3E3E46"
                android:centerColor="#1B1B1F"
                android:endColor="#0B0B0D" />
        </shape>
    </item>
</layer-list>
