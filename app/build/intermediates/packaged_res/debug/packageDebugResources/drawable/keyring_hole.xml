<?xml version="1.0" encoding="utf-8"?>
<!-- Keyring hole: chrome ring around a dark hole. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:endColor="#8E959B"
                android:startColor="#FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#5F656B" />
        </shape>
    </item>

    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="oval">
            <solid android:color="#0E0E0E" />
        </shape>
    </item>
</layer-list>
