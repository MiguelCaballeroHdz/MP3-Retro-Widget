<?xml version="1.0" encoding="utf-8"?>
<!-- OVAL: silver chrome case, strongly rounded. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <gradient
                android:angle="270"
                android:startColor="#FCFDFE"
                android:centerColor="#C7CCD3"
                android:endColor="#8D949D" />
            <stroke
                android:width="1dp"
                android:color="#5F666D" />
        </shape>
    </item>
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="27dp" />
            <gradient
                android:angle="270"
                android:startColor="#5AFFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#38000000" />
        </shape>
    </item>
</layer-list>
