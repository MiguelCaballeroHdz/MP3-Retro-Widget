<?xml version="1.0" encoding="utf-8"?>
<!-- Small metal slider button (thumb-slider look from the reference photo). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="7dp" />
            <gradient
                android:angle="270"
                android:centerColor="#CFD4D9"
                android:endColor="#868D93"
                android:startColor="#FCFCFD" />
            <stroke
                android:width="1dp"
                android:color="#666C72" />
        </shape>
    </item>

    <!-- top specular ridge -->
    <item
        android:bottom="8dp"
        android:left="4dp"
        android:right="4dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <solid android:color="#66FFFFFF" />
        </shape>
    </item>
</layer-list>
