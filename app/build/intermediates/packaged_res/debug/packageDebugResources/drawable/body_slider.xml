<?xml version="1.0" encoding="utf-8"?>
<!-- SLIDER: glossy piano-black body (fixed, it does not slide). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="9dp" />
            <gradient
                android:angle="270"
                android:startColor="#43434A"
                android:centerColor="#141416"
                android:endColor="#040405" />
            <stroke
                android:width="1dp"
                android:color="#000000" />
        </shape>
    </item>
    <item
        android:bottom="6dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="7dp" />
            <gradient
                android:angle="270"
                android:startColor="#5AFFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
