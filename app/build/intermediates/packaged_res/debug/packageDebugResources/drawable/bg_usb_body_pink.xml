<?xml version="1.0" encoding="utf-8"?>
<!-- Single-colour metallic body, skin 3: PINK metal. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="30dp" />
    <gradient
        android:angle="270"
        android:centerColor="#EFA9CC"
        android:endColor="#C0759C"
        android:startColor="#FFF0F7" />
    <stroke
        android:width="1dp"
        android:color="#B4739A" />
</shape>
