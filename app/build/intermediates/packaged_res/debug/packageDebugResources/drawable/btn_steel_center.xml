<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:centerX="0.4"
                android:centerY="0.32"
                android:gradientRadius="32dp"
                android:startColor="#94A3B0"
                android:centerColor="#5D6C79"
                android:endColor="#2A3742" />
            <stroke
                android:width="1dp"
                android:color="#141C22" />
        </shape>
    </item>
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:centerX="0.36"
                android:centerY="0.3"
                android:gradientRadius="26dp"
                android:startColor="#C6D3DD"
                android:centerColor="#6E7E8B"
                android:endColor="#38454F" />
        </shape>
    </item>
</layer-list>
