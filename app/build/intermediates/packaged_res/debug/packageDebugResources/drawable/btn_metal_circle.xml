<?xml version="1.0" encoding="utf-8"?>
<!-- Chrome wheel: raised mirror bezel + brushed metal disc with an offset
     specular highlight (light coming from the top-left) so it reads as 3D. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outer chrome bezel -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:centerX="0.45"
                android:centerY="0.4"
                android:gradientRadius="42dp"
                android:startColor="#FFFFFF"
                android:centerColor="#C9D0D5"
                android:endColor="#5A6167" />
            <stroke
                android:width="1dp"
                android:color="#3E4449" />
        </shape>
    </item>

    <!-- Inner disc: brushed chrome, highlight offset top-left -->
    <item
        android:bottom="5dp"
        android:left="7dp"
        android:right="5dp"
        android:top="7dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:centerX="0.32"
                android:centerY="0.28"
                android:gradientRadius="30dp"
                android:startColor="#FFFFFF"
                android:centerColor="#E9EDF0"
                android:endColor="#8A9298" />
            <stroke
                android:width="1dp"
                android:color="#B0B7BC" />
        </shape>
    </item>
</layer-list>
