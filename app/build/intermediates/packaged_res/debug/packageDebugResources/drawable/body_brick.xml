<?xml version="1.0" encoding="utf-8"?>
<!-- BRICK: blue-grey matte plastic brick. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient
                android:angle="270"
                android:startColor="#71808F"
                android:centerColor="#4A5866"
                android:endColor="#2C3741" />
            <stroke
                android:width="1dp"
                android:color="#1B2229" />
        </shape>
    </item>
    <item
        android:bottom="4dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <gradient
                android:angle="270"
                android:startColor="#33FFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#33000000" />
        </shape>
    </item>
</layer-list>
