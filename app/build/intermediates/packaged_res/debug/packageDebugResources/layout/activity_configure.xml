<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E0E10"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/configure_title"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/configure_skin_label"
            android:textColor="#8C919B"
            android:textSize="12sp" />

        <!-- live preview of the selected skin -->
        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="140dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp">

            <ImageView
                android:id="@+id/imgSkinPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/body_oval"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/imgSkinScreen"
                android:layout_width="46dp"
                android:layout_height="58dp"
                android:layout_gravity="center_horizontal|top"
                android:layout_marginTop="16dp"
                android:background="@drawable/lcd_oval"
                android:contentDescription="@null" />
        </FrameLayout>

        <RadioGroup
            android:id="@+id/skinGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/skin0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/skin_oval"
                android:textColor="#E6E6E6"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/skin1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/skin_brick"
                android:textColor="#E6E6E6"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/skin2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/skin_swivel_white"
                android:textColor="#E6E6E6"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/skin3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/skin_black2008"
                android:textColor="#E6E6E6"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/skin4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/skin_swivel_orange"
                android:textColor="#E6E6E6"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/skin5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/skin_slider"
                android:textColor="#E6E6E6"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/skin6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/skin_flip"
                android:textColor="#E6E6E6"
                android:textSize="13sp" />
        </RadioGroup>

        <!-- ================= PHOTO ================= -->
        <TextView
            style="@style/SettingsHeader"
            android:text="@string/photo_title" />

        <Button
            android:id="@+id/btnPickPhoto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/photo_pick" />

        <TextView
            android:id="@+id/txtPhotoStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/photo_none"
            android:textColor="#B9BCC4"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/photo_brightness"
            android:textColor="#E6E6E6"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/sbBrightness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50" />

        <TextView
            android:id="@+id/txtBrightnessValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="#9AA0AA"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/photo_darken"
            android:textColor="#E6E6E6"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/sbDarken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="0" />

        <TextView
            android:id="@+id/txtDarkenValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="#9AA0AA"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnClearPhoto"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/photo_clear"
            android:textColor="#FF8A65" />

        <!-- ================= NOTIFICATIONS ================= -->
        <TextView
            style="@style/SettingsHeader"
            android:text="@string/notifications_button" />

        <Button
            android:id="@+id/btnNotifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/notifications_button" />

        <TextView
            android:id="@+id/txtNotificationStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/notifications_missing"
            android:textColor="#FFCC80"
            android:textSize="12sp" />

        <!-- ================= ACTIONS ================= -->
        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/configure_save" />

        <Button
            android:id="@+id/btnClose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/configure_close" />

        <Button
            android:id="@+id/btnOpenSettings"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/configure_open_settings"
            android:textColor="#FF9800" />
    </LinearLayout>
</ScrollView>
