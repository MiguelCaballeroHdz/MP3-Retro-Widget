<?xml version="1.0" encoding="utf-8"?>
<!-- ORANGE skin: exact vertical MP3 artwork supplied by the user.
     The body is a single photo asset; the LCD contents and the three key
     hitboxes are overlaid at the measured positions of the artwork.
     Checked against the source image:
       LCD frame  x 259..772  y 519..1148   (834 x 1576 body crop)
       prev key   centre 242,1462   play key centre 513,1500
       next key   centre 803,1462 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/orange_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- The artwork keeps its own aspect ratio: 834 x 1576. -->
    <FrameLayout
        android:id="@+id/orange_device"
        android:layout_width="108dp"
        android:layout_height="204dp"
        android:layout_gravity="center">

        <ImageView
            android:id="@+id/orange_body"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/skin_orange_body" />

        <!-- Optional photo: masked to the orange shell only, so it never
             covers the silver faceplate, the screen or the keys. -->
        <ImageView
            android:id="@+id/orange_photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:visibility="gone" />

        <!-- ======================= LCD ======================= -->
        <FrameLayout
            android:id="@+id/orange_lcd"
            android:layout_width="66.5dp"
            android:layout_height="81.5dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="20.1dp"
            android:layout_marginTop="34.4dp"
            android:background="@drawable/lcd_orange_dynamic">

            <ImageView
                android:id="@+id/orange_note"
                android:layout_width="18.6dp"
                android:layout_height="26.8dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="19.9dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/skin_orange_note" />

            <TextView
                android:id="@+id/orange_title"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_gravity="top"
                android:layout_marginTop="52.5dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-light"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingStart="3dp"
                android:paddingEnd="3dp"
                android:text="@string/lcd_no_disc"
                android:textColor="#E9F1F3"
                android:textSize="7dp" />

            <ProgressBar
                android:id="@+id/orange_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_gravity="top"
                android:layout_marginTop="68.4dp"
                android:indeterminate="false"
                android:max="1000"
                android:progress="0"
                android:progressDrawable="@drawable/progress_orange" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_gravity="top"
                android:layout_marginTop="71.2dp"
                android:paddingStart="2.2dp"
                android:paddingEnd="2.2dp">

                <Chronometer
                    android:id="@+id/orange_chrono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:fontFamily="sans-serif-light"
                    android:format="%s"
                    android:includeFontPadding="false"
                    android:textColor="#DFE9EA"
                    android:textSize="5.5dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/orange_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:fontFamily="sans-serif-light"
                    android:includeFontPadding="false"
                    android:text="0:00"
                    android:textColor="#DFE9EA"
                    android:textSize="5.5dp"
                    android:visibility="gone" />
            </RelativeLayout>
        </FrameLayout>

        <!-- ======================= KEYS ======================= -->
        <FrameLayout
            android:id="@+id/orange_prev"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="4.9dp"
            android:layout_marginTop="143.6dp"
            android:contentDescription="@string/cd_prev" />

        <FrameLayout
            android:id="@+id/orange_play"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="33dp"
            android:layout_marginTop="141.4dp"
            android:contentDescription="@string/cd_play_pause" />

        <FrameLayout
            android:id="@+id/orange_next"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="77.5dp"
            android:layout_marginTop="143.6dp"
            android:contentDescription="@string/cd_next" />
    </FrameLayout>
</FrameLayout>
