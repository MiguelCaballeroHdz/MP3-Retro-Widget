<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E0E10"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:letterSpacing="0.14"
            android:text="@string/settings_subtitle"
            android:textColor="#FF9800"
            android:textSize="11sp" />

        <!-- ================= WIDGETS ================= -->
        <TextView
            style="@style/SettingsHeader"
            android:text="@string/widget_list_title" />

        <LinearLayout
            android:id="@+id/widgetList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnAddWidget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/add_widget" />

        <!-- ================= PHOTO ================= -->
        <TextView
            style="@style/SettingsHeader"
            android:text="@string/photo_title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgPhotoPreview"
                android:layout_width="66dp"
                android:layout_height="132dp"
                android:background="#1B1B20"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtPhotoStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/photo_none"
                    android:textColor="#B9BCC4"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnPickPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/photo_pick" />

                <Button
                    android:id="@+id/btnClearPhoto"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/photo_clear"
                    android:textColor="#FF8A65" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/lblBrightness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/photo_brightness"
            android:textColor="#E6E6E6"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/sbBrightness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50" />

        <TextView
            android:id="@+id/txtBrightnessValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="#9AA0AA"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/photo_darken"
            android:textColor="#E6E6E6"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/sbDarken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="0" />

        <TextView
            android:id="@+id/txtDarkenValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="#9AA0AA"
            android:textSize="11sp" />

        <!-- ================= NOTIFICATIONS ================= -->
        <TextView
            style="@style/SettingsHeader"
            android:text="@string/notifications_button" />

        <Button
            android:id="@+id/btnNotifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/notifications_button" />

        <TextView
            android:id="@+id/txtNotificationStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/notifications_missing"
            android:textColor="#FFCC80"
            android:textSize="12sp" />

        <!-- ================= HIDE FROM DRAWER ================= -->
        <TextView
            style="@style/SettingsHeader"
            android:text="@string/hide_title" />

        <Switch
            android:id="@+id/switchHide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hide_title"
            android:textColor="#E6E6E6"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hide_summary"
            android:textColor="#8C919B"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/txtHideStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/hide_off"
            android:textColor="#FFCC80"
            android:textSize="12sp" />

        <!-- ================= HELP ================= -->
        <TextView
            style="@style/SettingsHeader"
            android:text="@string/tutorial_title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:text="@string/tutorial_text"
            android:textColor="#C7CAD1"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
