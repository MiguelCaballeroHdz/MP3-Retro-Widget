<?xml version="1.0" encoding="utf-8"?>
<!-- OVAL: backlit orange LCD. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <gradient
                android:angle="270"
                android:startColor="#FFC472"
                android:centerColor="#FFB25A"
                android:endColor="#F09E43" />
            <stroke
                android:width="1dp"
                android:color="#C17A20" />
        </shape>
    </item>
</layer-list>
