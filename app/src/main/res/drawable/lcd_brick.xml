<?xml version="1.0" encoding="utf-8"?>
<!-- BRICK: pixel green screen. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="3dp" />
            <gradient
                android:angle="270"
                android:startColor="#0F3A1B"
                android:centerColor="#0A2A13"
                android:endColor="#05180B" />
            <stroke
                android:width="1dp"
                android:color="#04120A" />
        </shape>
    </item>
</layer-list>
