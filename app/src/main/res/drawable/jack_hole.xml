<?xml version="1.0" encoding="utf-8"?>
<!-- 3.5mm headphone jack: chrome rim + dark socket. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:endColor="#8B9298"
                android:startColor="#F5F5F5" />
            <stroke
                android:width="1dp"
                android:color="#5A6066" />
        </shape>
    </item>

    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="oval">
            <solid android:color="#0B0B0B" />
        </shape>
    </item>
</layer-list>
