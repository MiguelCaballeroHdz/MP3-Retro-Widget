<?xml version="1.0" encoding="utf-8"?>
<!-- OVAL: small metal top tab. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <gradient
                android:angle="270"
                android:startColor="#F6F8FA"
                android:centerColor="#C2C8D0"
                android:endColor="#8B929B" />
            <stroke
                android:width="1dp"
                android:color="#6A717A" />
        </shape>
    </item>
</layer-list>
