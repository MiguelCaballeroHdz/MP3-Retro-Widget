<?xml version="1.0" encoding="utf-8"?>
<!-- Keypad plate: red-orange lacquer. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:angle="270"
                android:startColor="#FF6A3D"
                android:centerColor="#E0431D"
                android:endColor="#A82A0E" />
            <stroke
                android:width="1dp"
                android:color="#6E1B08" />
        </shape>
    </item>
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient
                android:angle="270"
                android:startColor="#55FFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#22000000" />
        </shape>
    </item>
</layer-list>
