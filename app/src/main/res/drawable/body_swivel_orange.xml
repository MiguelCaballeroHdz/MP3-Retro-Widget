<?xml version="1.0" encoding="utf-8"?>
<!-- SWIVEL NARANJA: grey shell, red-orange accents. No top tab, no logos. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="270"
                android:startColor="#C3C7CC"
                android:centerColor="#93989F"
                android:endColor="#666B72" />
            <stroke
                android:width="1dp"
                android:color="#474C52" />
        </shape>
    </item>
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="13dp" />
            <gradient
                android:angle="270"
                android:startColor="#44FFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#33000000" />
        </shape>
    </item>
</layer-list>
