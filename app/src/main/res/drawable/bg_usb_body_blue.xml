<?xml version="1.0" encoding="utf-8"?>
<!-- Single-colour metallic body, skin 2: DEEP NAVY car paint.
     Bright specular top -> deep navy bottom. Only the wheel/bezel/sliders are silver. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="30dp" />
    <gradient
        android:angle="270"
        android:centerColor="#1B3A54"
        android:endColor="#05101A"
        android:startColor="#5E93BF" />
    <stroke
        android:width="1dp"
        android:color="#081018" />
</shape>
