<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="15dp" />
            <gradient
                android:angle="270"
                android:startColor="#FF8659"
                android:centerColor="#E0431D"
                android:endColor="#A82A0E" />
            <stroke
                android:width="1dp"
                android:color="#6E1B08" />
        </shape>
    </item>
</layer-list>
