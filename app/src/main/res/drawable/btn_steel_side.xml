<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="15dp" />
            <gradient
                android:angle="270"
                android:startColor="#7E8C99"
                android:centerColor="#4E5C68"
                android:endColor="#2A3742" />
            <stroke
                android:width="1dp"
                android:color="#141C22" />
        </shape>
    </item>
</layer-list>
