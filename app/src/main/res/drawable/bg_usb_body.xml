<?xml version="1.0" encoding="utf-8"?>
<!-- Single-colour metallic body, skin 1: SILVER.
     Bright top -> dark bottom car-paint gradient (no half/half split). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="30dp" />
    <gradient
        android:angle="270"
        android:centerColor="#D6DADE"
        android:endColor="#A4AAB0"
        android:startColor="#FDFDFE" />
    <stroke
        android:width="1dp"
        android:color="#8B9197" />
</shape>
