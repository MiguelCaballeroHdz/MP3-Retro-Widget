<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MP3Retro" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">#3F51B5</item>
        <item name="android:colorPrimaryDark">#1B1B1B</item>
        <item name="android:colorAccent">#FF9800</item>
        <item name="android:windowBackground">#101010</item>
    </style>

    <style name="Theme.MP3Retro.NoTitleBar" parent="Theme.MP3Retro">
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- Transparent, no animation: only used to forward to the music app -->
    <style name="Theme.MP3Retro.Translucent" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="SettingsHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">26dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">#FF9800</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
